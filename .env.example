# StoryFrame image provider preference
STORYFRAME_DEFAULT_IMAGE_PROVIDER=gemini

# Google Cloud Vertex AI image generation ONLY
# Requests go to aiplatform.googleapis.com so eligible Google Cloud billing credits can be used.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Recommended production auth: paste the service-account JSON as a single Vercel secret value.
# The service account needs permission to use Vertex AI (for example Vertex AI User).
VERTEX_AI_SERVICE_ACCOUNT_JSON=

# Optional alternative: base64-encode the service-account JSON and put it here instead.
VERTEX_AI_SERVICE_ACCOUNT_BASE64=

# Simpler testing alternative: a Google Cloud AUTHORIZATION key bound to a service account
# and permitted for Vertex AI (aiplatform.googleapis.com). Do not use an ordinary AI Studio key here.
VERTEX_AI_API_KEY=

# Backwards-compatible aliases accepted by the provider:
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_API_KEY=
# GEMINI_API_KEY=   # only if this is a Google Cloud authorization key for Vertex AI

# Cloudflare optional alternate provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Pollinations text analysis + public image fallback
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MANGA_TEXT_MODEL=openai-fast
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux-anime
POLLINATIONS_ANALYZE_TIMEOUT_MS=90000
POLLINATIONS_IMAGE_TIMEOUT_MS=90000
