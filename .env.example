# Pollinations-only StoryFrame stack
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# Fast chapter analysis (server-side text API)
POLLINATIONS_MANGA_TEXT_MODEL=openai-fast
POLLINATIONS_ANALYZE_TIMEOUT_MS=90000

# Public image generation
# Image routes are hard-set to flux-anime and use https://image.pollinations.ai/prompt/...
POLLINATIONS_IMAGE_TIMEOUT_MS=90000

# Legacy text routes may still read this
POLLINATIONS_TEXT_MODEL=openai
