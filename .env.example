# Pollinations-only StoryFrame stack
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# Fast chapter analysis
POLLINATIONS_MANGA_TEXT_MODEL=openai-fast
POLLINATIONS_ANALYZE_TIMEOUT_MS=90000

# Image generation
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_REFERENCE_MODEL=flux
POLLINATIONS_MANGA_CONSISTENCY_MODEL=klein
POLLINATIONS_IMAGE_TIMEOUT_MS=90000

# Legacy routes may still read these
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_CONSISTENCY_MODEL=kontext
